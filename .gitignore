.env
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
**/.cache/
*.cache
*.cache.*
*.egg-info/
.gitignore
data/*.sqlite3
data/*.sqlite3-*
data/*.bak
data/.runtime/

# Local databases and generated database backups must never be committed.
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.bak

# NSE archives are downloaded on demand and kept locally; never commit them.
data/**/*.zip
data/*.zip
# FII/DII JSON snapshots and Nifty index CSV archives are runtime data too.
data/nse_archives/fii_dii/
data/nse_archives/indices/

# Frontend-local scratch/build output not covered by the nested frontend ignore file.
frontend/private/
.DS_Store
data/.DS_Store
*.md
!docs/
!docs/*.md
